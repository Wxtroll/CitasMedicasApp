@model IEnumerable<CitasMedicasApp.Models.Consulta>
@{ ViewData["Title"] = "Consultas"; }
<h1>Consultas</h1>
<table class="table">
    <thead><tr><th>Fecha de la cita</th><th>Paciente</th><th>Médico</th><th>Diagnóstico</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Cita.Paciente.Nombres @item.Cita.Paciente.Apellidos</td>
            <td>@item.Cita.Medico.Nombres @item.Cita.Medico.Apellidos</td>
            <td>@item.Diagnostico</td>
            <td><a asp-action="Details" asp-route-id="@item.ConsultaId">Detalles</a></td>
        </tr>
    }
    </tbody>
</table>
